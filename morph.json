{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-music-gen",
  "version": "1.0.0-beta.1",
  "description": "NON FONCTIONNEL (squelette d'API) — Extension autonome de composition musicale et d'effets sonores (MusicGen, AudioCraft, Stable Audio). Aucun moteur n'est embarqué : les appels échouent explicitement au lieu de fabriquer un résultat.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-music-gen",
  "repository": "https://github.com/Locaryn/morph-music-gen",
  "keywords": [
    "music-generation",
    "musicgen",
    "audiocraft",
    "sound-fx",
    "audio",
    "stable-audio"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur de synthèse musicale local."
    },
    "files.read": {
      "reason": "Lire les modèles musicaux et échantillons de référence."
    },
    "files.write": {
      "reason": "Sauvegarder les fichiers audio WAV/MP3 générés."
    },
    "network": {
      "reason": "Télécharger les modèles audio depuis HuggingFace."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "music-gen"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "music-gen-catalog",
        "slot": "marketplace.catalogs",
        "order": 16,
        "type": "data",
        "label": "Modèles de composition musicale",
        "icon": "music",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles MusicGen et AudioCraft au catalogue"
      },
      {
        "id": "music-gen-studio",
        "slot": "studio.tabs",
        "order": 16,
        "label": "Musique & Audio",
        "icon": "music",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-music-gen-panel",
        "hint": "Composition de morceaux et effets sonores"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "1.0.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (Pre-release) — non testée par des utilisateurs",
      "tag": "v1.0.0-beta.1",
      "released_at": "2026-08-28"
    },
    {
      "version": "0.9.0",
      "is_beta": false,
      "summary": "Version de référence stable",
      "tag": "v0.9.0",
      "released_at": "2026-08-20"
    },
    {
      "version": "0.8.5",
      "is_beta": false,
      "summary": "Version précédente stable",
      "tag": "v0.8.5",
      "released_at": "2026-08-15"
    },
    {
      "version": "0.8.0",
      "is_beta": false,
      "summary": "Version initiale du socle",
      "tag": "v0.8.0",
      "released_at": "2026-08-01"
    }
  ]
}
